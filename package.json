{
  "name": "ugoshop-rebuild",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "app",
    "server"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n server,app -c blue,green \"npm run dev -w server\" \"npm run dev -w app\"",
    "dev:server": "npm run dev -w server",
    "dev:app": "npm run dev -w app",
    "build": "npm run build -w server && npm run build -w app",
    "db:push": "npm run db:push -w server",
    "seed": "npm run seed -w server"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
